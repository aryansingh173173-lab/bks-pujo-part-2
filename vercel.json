{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/site",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/",
      "destination": "/site/index.html"
    },
    {
      "source": "/sponsors",
      "destination": "/site/sponsors/index.html"
    },
    {
      "source": "/sponsors/",
      "destination": "/site/sponsors/index.html"
    },
    {
      "source": "/farmers",
      "destination": "/site/farmers/index.html"
    },
    {
      "source": "/farmers/",
      "destination": "/site/farmers/index.html"
    },
    {
      "source": "/stakeholders",
      "destination": "/site/stakeholders/index.html"
    },
    {
      "source": "/stakeholders/",
      "destination": "/site/stakeholders/index.html"
    },
    {
      "source": "/stakeholders/:path*",
      "destination": "/site/stakeholders/:path*"
    },
    {
      "source": "/public",
      "destination": "/site/public/index.html"
    },
    {
      "source": "/public/",
      "destination": "/site/public/index.html"
    },
    {
      "source": "/nrb",
      "destination": "/site/nrb/index.html"
    },
    {
      "source": "/nrb/",
      "destination": "/site/nrb/index.html"
    },
    {
      "source": "/nrb/:path*",
      "destination": "/site/nrb/:path*"
    },
    {
      "source": "/start",
      "destination": "/site/start/index.html"
    },
    {
      "source": "/start/",
      "destination": "/site/start/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/site/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/memories.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/memories.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/ifs.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/ifs.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!site/(?:assets|fonts|scripts|styles)/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
